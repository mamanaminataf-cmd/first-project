# Variables d'environnement pour Bio Market
# Copier ce fichier en .env et remplir les valeurs

# Backend (à adapter selon le backend choisi)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Backend API (si backend séparé)
# API_URL=
# API_KEY=

# Stripe (Paiements)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

# Email (Notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Storage (Images)
# STORAGE_BUCKET=
# STORAGE_URL=
